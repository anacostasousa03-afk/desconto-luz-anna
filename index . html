<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@400;600;800&display=swap">
<style>
:root{
  --bg:#030603;--surface:#0C160C;--ink:#EAF5EA;--muted:#9DB59D;--line:#1C2E1C;
  --accent:#0AFF1F;--accent-ink:#030603;--accent-text:#0AFF1F;--err:#FF8A80;
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:light){
  :root:not([data-theme="dark"]){--bg:#F3FAF3;--surface:#FFFFFF;--ink:#06130A;--muted:#456045;--line:#CFE3CF;--accent-text:#0A7A16;--err:#B3261E}
}
:root[data-theme="light"]{--bg:#F3FAF3;--surface:#FFFFFF;--ink:#06130A;--muted:#456045;--line:#CFE3CF;--accent-text:#0A7A16;--err:#B3261E}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font-family:"Sora",system-ui,-apple-system,"Segoe UI",Roboto,Arial,sans-serif;line-height:1.6;-webkit-text-size-adjust:100%}
.wrap{max-width:600px;margin:0 auto;padding:0 20px}
.hero{background:radial-gradient(70% 45% at 50% 0%,color-mix(in srgb,var(--accent) 22%,transparent),transparent)}
.brand{padding:22px 0 8px;font-weight:800;font-size:1.35rem;letter-spacing:-.02em}
.brand span{color:var(--accent-text)}
.me{display:flex;align-items:center;gap:14px;margin:18px 0 22px}
.me img{width:84px;height:84px;border-radius:50%;object-fit:cover;border:3px solid var(--accent);flex:none}
.me p{margin:0;font-size:.92rem;color:var(--muted);line-height:1.4}
.me b{color:var(--ink);display:block;font-size:1rem}
h1{font-size:clamp(2rem,9vw,2.9rem);line-height:1.08;font-weight:800;letter-spacing:-.02em;margin:0 0 14px}
h2{font-size:1.45rem;line-height:1.2;margin:0 0 12px;font-weight:800;letter-spacing:-.01em}
p{margin:0 0 14px}
.lead{color:var(--muted);max-width:50ch}
.big{color:var(--accent-text);font-weight:800}
section{padding:34px 0 6px}
.card{background:var(--surface);border:1px solid var(--line);border-radius:18px;padding:22px 18px}
.card h2{font-size:1.1rem;margin:0 0 16px;font-weight:600;letter-spacing:0}
label{display:block;font-size:.9rem;font-weight:600;margin:0 0 6px}
.field{margin-bottom:14px}
input,select{width:100%;font:inherit;font-size:1rem;color:var(--ink);background:var(--bg);border:1.5px solid var(--line);border-radius:10px;padding:12px 14px;min-height:48px}
input::placeholder{color:var(--muted);opacity:.8}
input:focus-visible,select:focus-visible,button:focus-visible,a:focus-visible,summary:focus-visible{outline:3px solid var(--accent);outline-offset:2px}
.money{position:relative}
.money span{position:absolute;left:14px;top:50%;transform:translateY(-50%);color:var(--muted);font-weight:600}
.money input{padding-left:44px}
.err{color:var(--err);font-size:.85rem;margin:6px 0 0}
button{width:100%;font:inherit;font-weight:800;font-size:1.05rem;background:var(--accent);color:var(--accent-ink);border:0;border-radius:12px;padding:15px 16px;min-height:52px;cursor:pointer;margin-top:4px}
button:active{transform:translateY(1px)}
.fine{font-size:.8rem;color:var(--muted);margin:12px 0 0}
#fallback{display:none;margin-top:14px;font-size:.9rem}
#fallback a,.fine a,details a{color:var(--accent-text);font-weight:600}
.steps{list-style:none;padding:0;margin:0;counter-reset:s}
.steps li{counter-increment:s;display:flex;gap:14px;align-items:flex-start;margin-bottom:16px}
.steps li::before{content:counter(s);flex:none;width:32px;height:32px;border-radius:50%;background:var(--accent);color:var(--accent-ink);font-weight:800;display:grid;place-items:center}
.steps b{display:block}
.steps span{color:var(--muted);font-size:.92rem}
.note{border-left:4px solid var(--accent);background:var(--surface);padding:14px 16px;border-radius:0 12px 12px 0;font-size:.93rem}
.stats{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin:18px 0}
.stats div{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:14px 8px;text-align:center;font-size:.78rem;color:var(--muted);line-height:1.3}
.stats b{display:block;font-size:1.35rem;color:var(--accent-text);font-weight:800}
.svc{padding-left:18px;margin:0 0 14px}
.svc li{margin-bottom:6px}
details{border-bottom:1px solid var(--line)}
summary{cursor:pointer;list-style:none;padding:16px 28px 16px 0;font-weight:600;position:relative}
summary::-webkit-details-marker{display:none}
summary::after{content:"+";position:absolute;right:4px;top:12px;font-size:1.5rem;color:var(--accent-text);font-weight:400}
details[open] summary::after{content:"\2212"}
details p{color:var(--muted);font-size:.95rem;margin:0 0 16px}
.cta{padding:30px 0 10px}
.cta a{display:block;text-align:center;text-decoration:none;font-weight:800;background:var(--accent);color:var(--accent-ink);border-radius:12px;padding:15px 16px;min-height:52px}
footer{margin-top:30px;padding:22px 0 40px;border-top:1px solid var(--line);font-size:.78rem;color:var(--muted)}
</style>
</head>
<body>
<div class="hero">
  <div class="wrap">
    <div class="brand">i<span>Green</span> Energy</div>
    <div class="me">
      <img src="data:image/jpeg;base64," alt="Foto da licenciada iGreen que atende você">
      <p><b>Anna Sousa</b>Licenciada iGreen Energy &middot; ID 160810</p>
    </div>
    <h1>Sua conta de luz pode custar menos.</h1>
    <p class="lead">Com a energia por assinatura da iGreen, você recebe créditos de energia solar que abatem parte da sua fatura: <span class="big">desconto de até 15%</span> todo mês, sem investimento, sem obra e sem instalar nada na sua casa ou empresa.</p>
    <p class="lead">Você continua com a mesma distribuidora e o mesmo fornecimento de sempre. O que muda é quanto você paga por ele.</p>
  </div>
</div>

<div class="wrap">
  <section id="simular" style="padding-top:18px">
    <div class="card">
      <h2>Quero minha simulação gratuita</h2>
      <form id="f" novalidate>
        <div class="field">
          <label for="nome">Seu nome</label>
          <input id="nome" type="text" autocomplete="name" placeholder="Como posso te chamar?">
          <p class="err" id="e-nome" role="alert"></p>
        </div>
        <div class="field">
          <label for="cidade">Cidade e estado</label>
          <input id="cidade" type="text" autocomplete="address-level2" placeholder="Ex.: Recife - PE">
        </div>
        <div class="field">
          <label for="tipo">A conta é de</label>
          <select id="tipo"><option>Casa ou apartamento</option><option>Comércio ou empresa</option></select>
        </div>
        <div class="field">
          <label for="valor">Valor médio da conta por mês</label>
          <div class="money"><span>R$</span><input id="valor" type="text" inputmode="decimal" placeholder="350,00"></div>
          <p class="err" id="e-valor" role="alert"></p>
        </div>
        <button type="submit">Receber minha simulação no WhatsApp</button>
        <p class="fine">Ao tocar no botão, o WhatsApp abre com a sua mensagem pronta. O desconto varia conforme a distribuidora, o consumo e as condições do contrato.</p>
        <p id="fallback">O WhatsApp não abriu? <a id="fb-link" href="#" target="_blank" rel="noopener">Toque aqui para enviar a mensagem.</a></p>
      </form>
    </div>
  </section>

  <section>
    <h2>Como funciona</h2>
    <ol class="steps">
      <li><div><b>Você me envia o valor da conta</b><span>Leva menos de um minuto.</span></div></li>
      <li><div><b>Eu faço a simulação para o seu caso</b><span>Confirmo se a sua distribuidora e o seu consumo permitem a adesão.</span></div></li>
      <li><div><b>Você lê as condições e decide</b><span>Se fizer sentido, a adesão é feita online, pelo celular.</span></div></li>
    </ol>
    <div class="note"><b>O que muda na sua conta:</b> a energia solar compensa parte da fatura da distribuidora, e você paga a energia compensada à parte, normalmente por boleto. Ou seja, passa a receber <b>duas cobranças</b>. A economia é a diferença entre o que você pagava antes e a soma das duas.</div>
  </section>

  <section>
    <h2>Sobre a iGreen Energy</h2>
    <p>A iGreen Energy se apresenta como um ecossistema de energia e serviços sustentáveis. Na energia, a solução para casas e pequenas empresas conecta o cliente a usinas solares, e o desconto aparece em créditos aplicados na fatura da distribuidora.</p>
    <div class="stats">
      <div><b>+21</b>estados atendidos</div>
      <div><b>+1.000</b>usinas</div>
      <div><b>+30</b>distribuidoras integradas</div>
    </div>
    <p style="font-size:.78rem;color:var(--muted);margin-top:-6px">Números divulgados pela própria empresa em igreenenergy.com.br.</p>
    <p>Além da energia, a empresa também oferece:</p>
    <ul class="svc">
      <li>Planos de telefonia e internet 5G</li>
      <li>Seguros para carro e residência</li>
    </ul>
    <p>Empresas maiores podem ter outra solução, a migração para o Mercado Livre de Energia. Me chame que eu explico.</p>
  </section>

  <section>
    <h2>iGreen Club: o app que vem junto</h2>
    <p>Quem se torna cliente de energia entra automaticamente no iGreen Club, sem pagar nada a mais. É um aplicativo para Android e iPhone, sem cartão físico.</p>
    <ul class="svc">
      <li>Acompanhe sua conta de energia e sua economia</li>
      <li>Descontos em mais de 30 mil estabelecimentos parceiros: farmácias, restaurantes, lojas, cinemas e mais</li>
      <li>Mais de 600 mil produtos e serviços em oferta, com cupons de até 70% em parceiros selecionados</li>
      <li>Seu link de indicação, para gerar cashback</li>
    </ul>
    <p style="font-size:.78rem;color:var(--muted)">Os descontos variam conforme o parceiro e a sua região.</p>
  </section>

  <section>
    <h2>Indique e ganhe: Cashback Sustentável</h2>
    <p>Depois de ser cliente, você pode indicar amigos, família e conhecidos pelo seu link no app. A campanha vigente paga:</p>
    <div class="stats">
      <div><b>R$ 20</b>por indicação com a conta de energia ativada</div>
      <div><b>R$ 100</b>com 5 indicações no mês (R$ 200 com 10, R$ 300 com 15)</div>
      <div><b>0,5% a 2%</b>de cashback por mês, enquanto a conta indicada seguir paga</div>
    </div>
    <div class="note">O ganho depende de as pessoas indicadas serem aprovadas, ativarem a conta e manterem os pagamentos em dia. Não é renda garantida. Valores da campanha de outubro de 2026, que a iGreen pode alterar. Peça as regras atualizadas no atendimento.</div>
  </section>

  <section>
    <h2>Perguntas frequentes</h2>
    <details><summary>Como o desconto é possível?</summary><p>Usinas solares geram energia e distribuem créditos para os clientes. Esses créditos abatem parte do consumo na fatura da sua distribuidora. É o modelo de geração compartilhada, previsto na Lei 14.300/2022 e acompanhado pela ANEEL.</p></details>
    <details><summary>Vou receber duas contas?</summary><p>Sim. Você continua recebendo a fatura da distribuidora, agora menor, e recebe também a cobrança da energia compensada. Compare a soma das duas com o que você pagava antes.</p></details>
    <details><summary>Quanto eu vou economizar de verdade?</summary><p>A iGreen divulga desconto de até 15%. O percentual real depende da distribuidora, do seu consumo e do contrato. Em alguns contratos, o desconto é menor se o boleto for pago depois do vencimento. Peça sempre a simulação por escrito e confira essa regra.</p></details>
    <details><summary>Tem custo para aderir? Preciso de obra?</summary><p>A iGreen divulga a solução como sem investimento e sem instalação. Mesmo assim, leia o contrato e confirme se existe alguma taxa antes de assinar.</p></details>
    <details><summary>Minha luz pode ser cortada?</summary><p>O fornecimento continua sendo da sua distribuidora. Mas atenção: você precisa pagar as duas cobranças em dia, e o atraso na fatura da distribuidora pode gerar corte, como sempre.</p></details>
    <details><summary>Quem pode participar?</summary><p>Casas, apartamentos, comércios e pequenas empresas, dependendo da distribuidora da sua região e do seu consumo. Me envie o valor da conta que eu confirmo para você.</p></details>
    <details><summary>Posso cancelar?</summary><p>Pode, mas o contrato pode prever aviso prévio e regras para encerrar. Pergunte o prazo exato e leia a cláusula de cancelamento antes de assinar.</p></details>
    <details><summary>Posso desistir depois de assinar?</summary><p>Quando a contratação é feita à distância, como pelo celular, o Código de Defesa do Consumidor garante 7 dias para desistir, contados da assinatura (art. 49).</p></details>
    <details><summary>Quais documentos preciso enviar?</summary><p>Em geral, uma foto da conta de luz e um documento do titular. Eu te digo a lista exata no atendimento. Nunca envie senhas de nenhum aplicativo ou site.</p></details>
    <details><summary>Como funciona a indicação?</summary><p>Depois de ser cliente, você recebe um link de indicação no app iGreen Club. Quando a pessoa indicada é aprovada e ativa a conta de energia, você recebe o bônus da campanha vigente, mais um cashback mensal recorrente enquanto ela continuar pagando. Os valores podem mudar, então confirme as regras do momento.</p></details>
    <details><summary>Como acompanho minha economia?</summary><p>Pelo app iGreen Club, onde você vê a conta de energia e os benefícios do clube de descontos.</p></details>
  </section>

  <div class="cta"><a href="#simular">Quero minha simulação</a></div>

  <footer>
    Anna Sousa - Licenciada iGreen Energy - ID 160810. Esta página não é o site oficial da empresa. iGreen Energia Comércio e Serviços Ltda, CNPJ 44.159.238/0001-30. Site oficial: igreenenergy.com.br. Condições, descontos e prazos estão no contrato e podem variar por distribuidora.
  </footer>
</div>
<script>
(function(){
  var NUM="5581984729322";
  var f=document.getElementById("f"),nome=document.getElementById("nome"),valor=document.getElementById("valor");
  var eN=document.getElementById("e-nome"),eV=document.getElementById("e-valor");
  valor.addEventListener("input",function(){valor.value=valor.value.replace(/[^0-9,\.]/g,"")});
  f.addEventListener("submit",function(ev){
    ev.preventDefault();
    var n=nome.value.trim(),v=valor.value.trim();
    var cidade=document.getElementById("cidade").value.trim();
    var tipo=document.getElementById("tipo").value.toLowerCase();
    eN.textContent="";eV.textContent="";
    var ok=true;
    if(!n){eN.textContent="Digite seu nome para continuar.";ok=false}
    if(!v||!/\d/.test(v)){eV.textContent="Digite o valor médio da sua conta, por exemplo 350,00.";ok=false}
    if(!ok)return;
    var msg="Olá! Meu nome é "+n+". Quero a simulação de desconto na conta de luz."
      +" Conta de: "+tipo+"."+(cidade?" Cidade: "+cidade+".":"")+" Valor médio: R$ "+v+" por mês.";
    var url="https://api.whatsapp.com/send?phone="+NUM+"&text="+encodeURIComponent(msg);
    var fb=document.getElementById("fb-link");fb.href=url;
    document.getElementById("fallback").style.display="block";
    var a=document.createElement("a");a.href=url;a.target="_blank";a.rel="noopener";
    document.body.appendChild(a);a.click();document.body.removeChild(a);
  });
})();
</script>
</body>
</html>
